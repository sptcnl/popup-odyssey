FROM python:3.11-slim

# 시스템 의존성 + Chrome 완전 설치 (Selenium 최적화)
RUN apt-get update && apt-get install -y \
    wget gnupg unzip curl \
    chromium \
    cron \
    tzdata \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo-gobject2 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log /app/data /tmp

# ChromeDriver 143 정확한 경로로 설치 (오류 수정)
RUN wget -O /tmp/chromedriver.zip \
    https://storage.googleapis.com/chrome-for-testing-public/143.0.7499.169/linux64/chromedriver-linux64.zip && \
    unzip /tmp/chromedriver.zip -d /tmp/ && \
    mv /tmp/chromedriver-linux64/chromedriver /usr/local/bin/chromedriver && \
    chmod +x /usr/local/bin/chromedriver && \
    rm -rf /tmp/chromedriver*

# KST 시간대 설정
RUN ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime \
    && echo "Asia/Seoul" > /etc/timezone

WORKDIR /app

# Python 의존성 설치
COPY crawler/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 소스코드 복사
COPY crawler/crawler.py .
RUN chmod +x crawler.py

# 크론탭 설정 (매일 오전 9시 + 로그 로테이션)
RUN echo "0 9 * * * /usr/local/bin/python /app/crawler.py >> /var/log/crawler.log 2>&1" | crontab - \
    && echo "0 0 * * * find /var/log -name 'crawler.log.*' -mtime +7 -delete" | crontab -

# 로그 파일 권한 설정
RUN touch /var/log/crawler.log && chmod 666 /var/log/crawler.log

# 헬스체크
HEALTHCHECK --interval=1h --timeout=30s --start-period=5m --retries=3 \
    CMD ps aux | grep '[c]ron' || exit 1

EXPOSE 8080

CMD cron && tail -f /var/log/crawler.log