FROM mambaorg/micromamba:1.5.8

USER root
WORKDIR /app

# 1. 시스템 의존성 설치 (root)
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 2. Micromamba 사용자 복귀 + 환경 생성
USER $MAMBA_USER
COPY --chown=$MAMBA_USER:$MAMBA_USER environment.yml .
# micromamba create 시 pip 섹션 처리 위해 --no-pip 옵션 추가
RUN micromamba create -n myenv -f environment.yml --yes && \
    micromamba clean --all --yes

# 3. 환경 변수 설정
ENV PATH="/opt/conda/envs/myenv/bin:$PATH"
ENV LD_LIBRARY_PATH="/opt/conda/envs/myenv/lib:$LD_LIBRARY_PATH"
ENV GDAL_DATA="/opt/conda/envs/myenv/share/gdal"
ENV PROJ_LIB="/opt/conda/envs/myenv/share/proj"

# 4. GDAL 재설치 (시스템 라이브러리와 연동)
RUN micromamba run -n myenv micromamba install -c conda-forge \
    gdal=3.8.2 \
    --force-reinstall -y

# 5. pip 패키지 별도 설치 (권한 문제 해결)
COPY --chown=$MAMBA_USER:$MAMBA_USER requirements.txt .
RUN micromamba run -n myenv pip install -r requirements.txt

# 6. 애플리케이션 복사
COPY --chown=$MAMBA_USER:$MAMBA_USER . .

# 7. Django 마이그레이션 및 수집
RUN micromamba run -n myenv python manage.py collectstatic --noinput

EXPOSE 8000

# 8. Gunicorn 실행
CMD ["micromamba", "run", "-n", "myenv", "gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers=3", "--timeout=120"]